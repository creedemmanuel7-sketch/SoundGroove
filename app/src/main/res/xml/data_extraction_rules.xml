<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud backup / device transfer (API 31+).
  Room (favoris, playlists, historique) reste dans le backup cloud + transfert appareil.
  Exclure uniquement les prefs chiffrées Keystore (clé non portable).
  Pour un changement de téléphone fiable : export JSON manuel (BackupManager) en plus.
  https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="soundgroove_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="soundgroove_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
# URL publique de l'APK (CDN, GitHub Releases, etc.) — https uniquement
# Si absent ou invalide, le CTA pointe vers /downloads/soundgroove.apk
NEXT_PUBLIC_APK_URL=

# URL canonique du site (Open Graph, metadata)
NEXT_PUBLIC_SITE_URL=https://soundgroove.app

# --- Rate-limit distribué (optionnel) ---
# Sans ces variables, le middleware utilise un compteur in-memory par instance.
# Pour un plafond global multi-instance (Upstash Redis) :
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Futures API (placeholders — aucune clé réelle) ---
# DATABASE_URL=
# AUTH_SECRET=
# API_SECRET=
